# ─── Environment Configuration Files ──────────────────────────────────────────
# Server credentials and private environment settings are never committed.
# Frontend REACT_APP_* values are public browser build configuration; the
# reviewed staging and production contracts are committed without secrets.
#
# Structure:
#   Root-level (.env files for various scripts/workflows):
#     /.env                 — Legacy single env file (if used)
#     /.env.development     — Root dev env (if used)
#     /.env.production      — Root prod env (if used)
#
#   Frontend (.env files with webpack DefinePlugin auto-detection):
#     /frontend/.env                    — Legacy single env file (if used)
#     /frontend/.env.development        — Used by: npm run dev
#     /frontend/.env.production         — Used by: npm run build
#     /frontend/.env.*.local            — Any other local overrides
#
# Committed files (public values only):
#     /frontend/.env.example            — Template for developers
#     /frontend/.env.staging            — Staging build contract
#     /frontend/.env.production         — Production build contract

/.env
/.env.development
/.env.production
frontend/.env
frontend/.env.development
frontend/.env.*.local

# frontend build artifacts
frontend/dist/
frontend/node_modules/

# ---------------------------------------------------------------
# WordPress — wp/ subdirectory (NEVER commit these files)
# ---------------------------------------------------------------
# WordPress core is installed in wp/ on the server, not tracked here.
# Tracked: wp/wp-content/themes/, wp/wp-content/mu-plugins/, wp/wp-config-sample.php

# WordPress core files (match anywhere in wp/ tree — wp-admin/, wp-includes/, etc.)
wp-admin/
wp-includes/
wp-*.php
xmlrpc.php
license.txt
readme.html

# Keep sample configs (wp-*.php above would otherwise exclude them)
!wp/wp-config-sample.php
!*/wp/wp-config-sample.php

# Sensitive configuration — configure manually on the server, never commit
wp-config.php
wp-config-local.php
wp-config-*.php
wp-config.php.*
**/wp-config.php.*
!wp/wp-config-sample.php
!*/wp/wp-config-sample.php

# WordPress server-side .env (real secrets — only .env.example is committed)
wp/.env
wp/.env.local

# WordPress uploads (binary assets; use Media Library, not Git)
wp-content/uploads/

# WordPress object/page cache and generated files
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp/error_log

# Mirrored live directory transient artifacts (do not track)
drywalltoolbox/.ftpquota
drywalltoolbox/error_log
drywalltoolbox/wp/wp-content/updraft/backup_*.gz
drywalltoolbox/wp/wp-content/updraft/log*.txt

# SiteGround launch/live is a generated deployment overlay, not source.
# Rebuild it from canonical repo paths; never stage runtime files or secrets.
/launch/live/

# A local WordPress/site snapshot under launch is runtime-owned. It may contain
# a nested repository, WordPress core, plugins, uploads, logs, and secrets.
/launch/wp/

# Local WordPress runtime mirror used for launch-site inspection. Canonical DTB
# application source remains under drywalltoolbox/wp/; keep this entire mirror
# out of Git, including core, third-party plugins, uploads, caches, and secrets.
/drywalltoolbox/launch-wp/

# WordPress content tracked in this repo (wp/wp-content/):
#   wp/wp-content/themes/drywall-toolbox/           — legacy theme (kept until headless-base validated)
#   wp/wp-content/themes/headless-base/             — active minimal headless theme (zero frontend output)
#   wp/wp-content/mu-plugins/dtb-cors.php           — CORS mu-plugin (auto-loaded)
#   wp/wp-content/mu-plugins/dtb-schematics/        — Schematics domain module (public API: Rest/SchematicPublicApiController.php)
# All other installed themes and all plugins are installed on the server only.
wp-content/themes/twenty*/
wp-content/themes/yith*/
wp-content/plugins/

# Composer / PHP dependency directories
vendor/

# ---------------------------------------------------------------
# Schematic diagram images — served exclusively from the WordPress Media
# Library via the public schematic API (see
# drywalltoolbox/wp/wp-content/mu-plugins/dtb-schematics/Rest/
# SchematicPublicApiController.php and frontend/src/pages/SchematicsPage.jsx).
# They must never be re-added here as local build assets — that defeats the
# point of the WP-hosted pipeline and bloats every dist build and file
# transfer.
#
# NOTE: the actual local path is frontend/public/brands/, not public/brands/
# — a prior version of this pattern was anchored to a path that doesn't
# exist and silently matched nothing. Kept both anchors below.
#
# schematic_data.json metadata files ARE tracked (small JSON, no binary).
public/brands/*/Schematics/**/*.png
public/brands/*/Schematics/**/*.jpg
public/brands/*/Schematics/**/*.jpeg
public/brands/*/Schematics/**/*.webp
frontend/public/brands/*/Schematics/**/*.png
frontend/public/brands/*/Schematics/**/*.jpg
frontend/public/brands/*/Schematics/**/*.jpeg
frontend/public/brands/*/Schematics/**/*.webp

# Local backup directories (large binary files — not needed in the repo)
# The originals live here after scripts/convert_schematics_to_webp.py backs them up.
# To restore: copy back from backups/ and re-run the upload script.
backups/
products/launch/official/*.bak

# Catalog development workspace. Generated audits, reports, review batches,
# rollback snapshots, and retired consolidation experiments are not source.
products/dev/catalog-consolidation/
products/dev/seo-generation/
products/dev/seo-pre-generation/

# Generated by scripts/process_catalog_images.py
image-manifest.csv

# OS artifacts
ehthumbs.db
Desktop.ini
__pycache__/
*.pyc
*.zip
*.pre-enrich-parts-*
*.pre-enrich-*

# Launch Readiness Validation Suite — run artifacts and local credentials
scripts/launch-readiness/.venv/
scripts/launch-readiness/.env
scripts/launch-readiness/reports/output/

# Authenticated supplier catalog scraper: local session artifacts
scripts/supplier-catalog/.venv/
scripts/supplier-catalog/.browser-profile/
scripts/supplier-catalog/brands.json
scripts/supplier-catalog/output/

# SiteGround production deploy key material is local-only. Never commit it.
docs/deployment/dtb-github-production-private.txt
docs/deployment/dtb-github-production-public.txt
