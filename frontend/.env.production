# Drywall Toolbox production frontend configuration
#
# Every value in this file is embedded in downloadable browser JavaScript and
# is public by definition. Server credentials and provider secrets belong in
# secured WordPress/host configuration, never in frontend environment files.

# WordPress and WooCommerce share the canonical production origin. WordPress
# core lives physically in /wp, while the public REST aliases remain at /wp-json.
REACT_APP_WP_BASE_URL=https://drywalltoolbox.com
REACT_APP_API_BASE_URL=https://drywalltoolbox.com
REACT_APP_STORE_API_BASE=/wp-json/wc/store/v1

# Root-mounted production site/build metadata.
REACT_APP_SITE_URL=https://drywalltoolbox.com
REACT_APP_ENV=production
REACT_APP_SEARCH_INDEXING=1
REACT_APP_REWARDS_ENABLED=0
REACT_APP_DTB_CATALOG_PLATFORM=0

# WooPayments is configured and enabled by its WooCommerce extension in
# WordPress. The storefront hands checkout to the native WooCommerce Checkout
# Block; React does not need WooPayments or Stripe API keys or payment fields.
