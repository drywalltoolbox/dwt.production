{
  "name": "drywall-toolbox-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://drywalltoolbox.com/",
  "scripts": {
    "dev": "webpack serve --config webpack.config.cjs --mode development",
    "media:generate": "node scripts/generate-responsive-hero-media.cjs",
    "build": "npm run build:siteground-root",
    "build:siteground-root": "npm run media:generate && cross-env APP_ENV=production PUBLIC_URL=/ node scripts/assert-public-env-safe.cjs pre && cross-env APP_ENV=production PUBLIC_URL=/ webpack --config webpack.config.cjs --mode production && cross-env APP_ENV=production PUBLIC_URL=/ node scripts/assert-build-routing.cjs && cross-env APP_ENV=production node scripts/assert-public-env-safe.cjs post",
    "build:staging": "npm run media:generate && cross-env APP_ENV=staging PUBLIC_URL=/staging node scripts/assert-public-env-safe.cjs pre && cross-env APP_ENV=staging PUBLIC_URL=/staging webpack --config webpack.config.cjs --mode production && cross-env APP_ENV=staging PUBLIC_URL=/staging node scripts/assert-build-routing.cjs && cross-env APP_ENV=staging node scripts/assert-public-env-safe.cjs post",
    "clean:build-cache": "node scripts/clean-build-artifacts.cjs cache",
    "lint": "eslint src",
    "preview": "webpack serve --config webpack.config.cjs --mode production"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "axios": "^1.7.9",
    "dompurify": "^3.0.6",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.563.0",
    "match-sorter": "^8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.1",
    "sharp": "^0.35.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.106.1",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  }
}
