# Drywall Toolbox SiteGround staging routing
# Deployment directory: /public_html/staging/
# Shared WordPress core: /public_html/wp/
# React build: upload the CONTENTS of dist-staging/ into this directory.

DirectoryIndex index.html index.php
Options -Indexes
Options +FollowSymLinks
FileETag None

ErrorDocument 400 /staging/errors/400.html
ErrorDocument 401 /staging/errors/401.html
ErrorDocument 403 /staging/errors/403.html
ErrorDocument 404 /staging/errors/404.html
ErrorDocument 405 /staging/errors/405.html
ErrorDocument 408 /staging/errors/408.html
ErrorDocument 409 /staging/errors/409.html
ErrorDocument 410 /staging/errors/410.html
ErrorDocument 413 /staging/errors/413.html
ErrorDocument 414 /staging/errors/414.html
ErrorDocument 415 /staging/errors/415.html
ErrorDocument 422 /staging/errors/422.html
ErrorDocument 429 /staging/errors/429.html
ErrorDocument 500 /staging/errors/500.html
ErrorDocument 502 /staging/errors/502.html
ErrorDocument 503 /staging/errors/503.html
ErrorDocument 504 /staging/errors/504.html

<FilesMatch "(^\.|wp-config\.php$|\.env(?:\..*)?$|composer\.(?:json|lock)$|package-lock\.json$|package\.json$|.*\.(?:bak|backup|old|orig|save|sql|sqlite|log|ini|sh|ps1|pem|key)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /staging/
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^bridge2cart/ - [L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
  RewriteRule ^ https://drywalltoolbox.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.drywalltoolbox\.com$ [NC]
  RewriteRule ^ https://drywalltoolbox.com%{REQUEST_URI} [R=301,L,NE]

  # Staging shares the root WordPress/WooCommerce runtime. These internal
  # aliases preserve same-origin cookies while keeping one REST authority.
  RewriteRule ^wp-json/?$ /wp/index.php?rest_route=/ [QSA,L]
  RewriteRule ^wp-json/(.*)$ /wp/index.php?rest_route=/$1 [QSA,L]
  RewriteRule ^dtb/(.*)$ /wp/index.php?rest_route=/dtb/$1 [QSA,L]
  RewriteRule ^wc-api/?$ /wp/index.php [QSA,L]

  # The staging frontend previews the storefront only. Its ordinary checkout
  # entry canonicalizes to the one native WooCommerce checkout at domain root.
  # Keep historical order-pay/order-received callbacks below untouched.
  RewriteRule ^checkout/?$ /checkout/ [R=302,L,NE]
  RewriteRule ^checkout/order-pay/([0-9]+)/?$ /wp/index.php?pagename=checkout&order-pay=$1 [QSA,L]
  RewriteRule ^order-pay/([0-9]+)/?$ /wp/index.php?pagename=checkout&order-pay=$1 [QSA,L]
  RewriteRule ^checkout/order-received/([0-9]+)/?$ /wp/index.php?pagename=checkout&order-received=$1 [QSA,L]

  # Redirect-capable provider returns must reach WooCommerce before the React
  # homepage rule so the native order lifecycle can verify and finalize them.
  RewriteCond %{QUERY_STRING} (^|&)order_id=[0-9]+(&|$) [NC]
  RewriteCond %{QUERY_STRING} (^|&)key=wc_order_[^&]+(&|$) [NC]
  RewriteCond %{QUERY_STRING} (^|&)payment_intent=pi_[^&]+(&|$) [NC]
  RewriteRule ^$ /wp/index.php [QSA,L]

  # Successful non-redirect payments can use WooCommerce's plain-permalink
  # order-received URL. Keep it in the shared authoritative runtime and let
  # WooCommerce validate the order key before the tracking handoff.
  RewriteCond %{QUERY_STRING} (^|&)order-received=[0-9]+(&|$) [NC]
  RewriteCond %{QUERY_STRING} (^|&)key=wc_order_[^&]+(&|$) [NC]
  RewriteRule ^$ /wp/index.php [QSA,L]

  # Reduced/query-string order-pay shapes must also stay in WooCommerce.
  RewriteCond %{QUERY_STRING} (^|&)(pay_for_order=true|order-pay=[0-9]+)(&|$) [NC]
  RewriteCond %{QUERY_STRING} (^|&)key=wc_order_ [NC]
  RewriteRule ^checkout/?$ /wp/index.php?pagename=checkout [QSA,L]

  RewriteRule ^$ index.html [L]
  RewriteRule ^wp-admin/?$ /wp/wp-admin/ [R=302,L,NE]
  RewriteRule ^wp-admin/(.*)$ /wp/wp-admin/$1 [R=302,L,QSA,NE]
  RewriteRule ^wp-login\.php$ /wp/wp-login.php [R=302,L,QSA,NE]
  RewriteRule ^wp-content/(.*)$ /wp/wp-content/$1 [L,QSA]
  RewriteRule ^wp-includes/(.*)$ /wp/wp-includes/$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} \.(?:css|js|mjs|map|json|webmanifest|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|pdf|txt|xml)$ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/staging/\.well-known/ [NC]
  RewriteRule ^ - [R=404,L]
  RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header unset ETag
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self \"https://js.stripe.com\" \"https://hooks.stripe.com\" \"https://b.stripecdn.com\" \"https://pay.google.com\"), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    <If "%{REQUEST_URI} =~ m#^/staging/(?:wp-admin|wp-login\.php|wp-json|dtb|wp-cron\.php|xmlrpc\.php|cart|checkout|account|my-account|dashboard|orders|addresses|rewards|login|register|forgot-password|lost-password|reset-password|logout|wc-api)(?:/|$)#i || %{QUERY_STRING} =~ m#(^|&)(?:rest_route=|pay_for_order=true|order-pay=[0-9]+|order-received=[0-9]+|wc-api=|order_id=[0-9]+|payment_intent=|key=wc_order_)#i || %{HTTP_COOKIE} =~ m#(?:^|;\s*)(?:wordpress_logged_in_|wordpress_sec_|wordpress_test_cookie|wp-settings-|woocommerce_cart_hash|woocommerce_items_in_cart|wp_woocommerce_session_|dtb_auth)#i">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always merge Vary Cookie
    Header always merge Vary Authorization
  </If>

  # The public staging shell is never a customer/session response. Permit the
  # browser back/forward cache while still forcing a network revalidation for a
  # normal navigation, so a deploy cannot strand a visitor on an old shell.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "^(?:site\.webmanifest|service-worker\.js|asset-manifest\.json|[45][0-9]{2}\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|svg|ico|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:js|mjs|css)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.[a-f0-9]{8}(?:\.chunk)?\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
